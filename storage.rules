rules_version = '2';

// Storage do Time Lobão.
// - Vídeos de exercício: o personal envia só na própria pasta (até 20 MB, só
//   vídeo); qualquer usuário logado pode assistir (alunos veem os vídeos dos treinos).
// - Fotos de avaliação (leva 2): só o personal do vínculo e o próprio aluno.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isTrainer() { return signedIn() && request.auth.token.role == 'trainer'; }

    match /trainers/{trainerId}/exercise-videos/{file} {
      allow read: if signedIn();
      allow create, update: if isTrainer() && request.auth.uid == trainerId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if isTrainer() && request.auth.uid == trainerId;
    }

    // Fotos de evolução: só o personal do vínculo e o aluno com vínculo ativo.
    match /studentLinks/{linkId}/photos/{file} {
      function link() {
        return firestore.get(/databases/(default)/documents/studentLinks/$(linkId)).data;
      }
      function canAccess() {
        return signedIn() && (
          link().trainerId == request.auth.uid ||
          (link().studentUid == request.auth.uid && link().linkStatus == 'active'));
      }
      allow read: if canAccess();
      allow create: if canAccess()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && link().trainerId == request.auth.uid;
    }

    // Foto de perfil: só o dono envia/apaga (imagem até 5 MB); qualquer
    // usuário logado vê (o personal vê a foto dos alunos).
    match /users/{uid}/{file} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
